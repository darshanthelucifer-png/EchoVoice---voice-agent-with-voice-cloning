# ==============================================================================
# EchoVoice Configuration Template (.env.example)
# Copy this file to .env and fill in your values.
# No paid APIs are required: all models are free and open-source on Hugging Face.
# ==============================================================================

# --- Hugging Face Credentials ---
# Fine-grained, read-only token from: https://huggingface.co/settings/tokens
# Required to access gated or rate-limited open-source models via HF Hub.
HF_TOKEN=

# --- Application Settings ---
APP_NAME=EchoVoice
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# --- Security & JWT Authentication ---
# Generate a secure key in bash/powershell with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Default: Async SQLite database for zero-config local development.
# For production PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/echovoice
DATABASE_URL=sqlite+aiosqlite:///./echovoice.db

# --- Storage Directories (Local File System) ---
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
VOICE_PROFILES_DIR=./data/voice_profiles
EXPORTS_DIR=./data/exports
CHECKPOINTS_DIR=./data/checkpoints

# --- Open-Source AI Models (Swappable purely via config) ---
# ASR: Whisper large-v3-turbo with distil-large-v3 fallback
ASR_MODEL=openai/whisper-large-v3-turbo
ASR_FALLBACK_MODEL=distil-whisper/distil-large-v3

# LLM: Open weights instructed model (free via HF Inference API)
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct

# RAG: Embeddings & Reranker
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# TTS & Voice Cloning: XTTS-v2 / OpenVoiceV2 / F5-TTS
TTS_ENGINE=xtts_v2

# Translation: NLLB-200 600M distilled (200 languages)
TRANSLATE_MODEL=facebook/nllb-200-distilled-600M

# Audio Enhancement: Resemble-Enhance / DeepFilterNet
ENHANCE_MODEL=ResembleAI/resemble-enhance

# --- YouTube-Standard Audio Mastering Presets ---
# Presets: youtube_voiceover, podcast_warm, deep_narrator, clean_neutral
DEFAULT_MASTERING_PRESET=youtube_voiceover
TARGET_LUFS=-14.0
TRUE_PEAK_DB=-1.5

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute
